<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="MovieWatchlist"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MovieWatchlist">

        <activity android:name=".ui.watchlists.WatchlistsActivity" />
        <activity android:name=".ui.queries.QueriesActivity" />
        <activity android:name=".ui.reviews.ReviewsActivity" />
        <activity android:name=".ui.reviews.AddEditReviewActivity" />
        <activity android:name=".ui.reviews.FirestoreQueriesActivity" />

        <activity
            android:name=".ui.movies.AddMovieActivity"
            android:exported="false" />
        <activity android:name=".ui.watchlists.AddWatchlistActivity" />

        <activity android:name=".ui.watchlists.WatchlistDetailsActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
